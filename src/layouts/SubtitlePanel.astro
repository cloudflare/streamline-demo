<div class="subtitles-panel" id="subtitlesPanel" data-subtitles-interface>
  <h3>Subtitle Controls</h3>
  <div class="field">
    <label for="subtitleVideoId">Stream Video ID</label>
    <input type="text" id="subtitleVideoId" placeholder="cf1e..." />
    <p class="hint">Defaults to the Video ID from Settings. Enter a different ID to test another video.</p>
  </div>
  <div class="subtitle-status" id="subtitleStatus">
    <p class="status-text">Click <strong>Start Streaming</strong> to begin processing.</p>
  </div>
  <div class="subtitle-info" id="subtitleInfo" style="display: none;">
    <div class="subtitle-badge">Subtitles</div>
    <div class="subtitle-meta">
      <span id="subtitleLang">Language: &mdash;</span>
      <span id="subtitleCues">Cues: &mdash;</span>
    </div>
  </div>
</div>

<script>
  import { initializeSubtitlesInterface } from '../lib/subtitles-interface'

  initializeSubtitlesInterface()
</script>

