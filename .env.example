# For local development only, RTMPS source and destination profiles. For production, these values should be set in Workers secrets.
MEDIA_PROFILE_ID=default

# RTMPS Source Stream Live Input to pull from. Provide its ID and RTMPS Playback Key
MEDIA_RTMP_INPUT_PROFILE={"liveInputId":"REDACTED_32_CHARACTER_INPUT_ID","key":"REDACTED_PLAYBACK_KEY"}

# RTMPS Destination Stream Live Input to push to. Provide its ID and RTMPS Broadcast Key
MEDIA_RTMP_OUTPUT_PROFILE={"liveInputId":"REDACTED_32_CHARACTER_INPUT_ID","key":"REDACTED_BROADCAST_KEY"}

# Playground only. Use a separately generated 32+-character secret and a Turnstile secret.
# The public profile remains unavailable until all three values are configured.
PLAYGROUND_PRINCIPAL_SECRET=REDACTED_32_CHARACTER_SECRET
PLAYGROUND_TURNSTILE_SECRET=REDACTED_TURNSTILE_SECRET
# A site key is public but is configured as a Worker secret to keep deployment setup uniform.
PLAYGROUND_TURNSTILE_SITEKEY=REDACTED_TURNSTILE_SITEKEY
